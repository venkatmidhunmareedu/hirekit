[Unit]
Description=HireKit API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=hirekit
WorkingDirectory=/opt/hirekit/backend
EnvironmentFile=/etc/hirekit/backend.env
ExecStart=/home/hirekit/.local/bin/uv run --no-dev uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8080 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
