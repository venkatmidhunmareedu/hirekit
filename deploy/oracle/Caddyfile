# SITE_ADDRESS comes from .env (a domain, or <public-ip>.sslip.io; Caddy gets the certificate by
# itself). The browser talks to one origin, as with the Vite proxy in web/vite.config.ts.
{$SITE_ADDRESS} {
	encode gzip
	@api path /v1/* /healthz
	handle @api {
		reverse_proxy api:8080
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
