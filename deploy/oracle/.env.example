# Copy to .env on the VM (chmod 600). Never commit .env.
SITE_ADDRESS=hirekit.example.com
# Supabase session pooler (IPv4, port 5432), asyncpg driver, TLS on:
# postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require
DATABASE_URL=
OPENROUTER_API_KEY=
# The key variable keeps this name for any provider: put the DeepSeek key in it. For DeepSeek set all
# four lines (prices in USD per million tokens, from the provider's pricing page; they drive the
# USD 8 budget stop). Left unset, the OpenRouter defaults apply.
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_ID=deepseek-chat
# PRICE_INPUT_USD_PER_MTOK=
# PRICE_OUTPUT_USD_PER_MTOK=
# Images on Docker Hub (see build-push.sh): your Docker Hub user name; IMAGE_TAG empty means latest.
REGISTRY_NAMESPACE=
IMAGE_TAG=
