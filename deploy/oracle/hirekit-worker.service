[Unit]
Description=HireKit Worker
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=hirekit
WorkingDirectory=/opt/hirekit/backend
EnvironmentFile=/etc/hirekit/backend.env
ExecStart=/home/hirekit/.local/bin/uv run --no-dev python -m app.worker
Restart=always
RestartSec=3
# The Worker finishes the job in hand on SIGTERM; give it one model call plus slack.
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
