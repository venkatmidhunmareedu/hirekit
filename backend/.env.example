# Copy to .env for local development. Never commit .env.
ENV=development
PORT=8080
LOG_LEVEL=debug
LOG_FORMAT=console
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hirekit

# Model gateway (docs/design/gateway-lld.md). MODEL_MODE is deliberately not set
# here: it is read from the process environment only, and `make record` sets it
# to live on its own command line. The default is replay, which never calls out.
OPENROUTER_API_KEY=
MODEL_ID=anthropic/claude-haiku-4.5
GATEWAY_TIMEOUT_SECONDS=60
PRICE_INPUT_USD_PER_MTOK=1
PRICE_OUTPUT_USD_PER_MTOK=5
# RECORDINGS_DIR defaults to backend/recordings (an absolute path).
RECORD_RESPONSES=false
# Set to yes only after the OpenRouter key has a credit limit (read by make record).
KEY_CREDIT_LIMIT_CONFIRMED=
