# Copy to .env for local development. Never commit .env.
ENV=development
PORT=8080
LOG_LEVEL=debug
LOG_FORMAT=console
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hirekit

# Model gateway (docs/design/gateway-lld.md). MODEL_MODE is deliberately not set
# here: it is read from the process environment only, and `make record` sets it
# to live on its own command line. The default is replay, which never calls out.
# MODEL_BASE_URL is the model API endpoint; unset means OpenRouter (https://openrouter.ai/api/v1). It must be https (plain
# http only for localhost, 127.0.0.1 or ::1), with no user:pass in it. OPENROUTER_API_KEY holds the
# key for whatever endpoint is set here and is sent to it. Pointing at a router or proxy: pin
# MODEL_ID to one exact model id so a call cannot be routed to another model.
# MODEL_BASE_URL=
OPENROUTER_API_KEY=
MODEL_ID=anthropic/claude-haiku-4.5
GATEWAY_TIMEOUT_SECONDS=60
PRICE_INPUT_USD_PER_MTOK=1
PRICE_OUTPUT_USD_PER_MTOK=5
# RECORDINGS_DIR defaults to backend/recordings (an absolute path).
RECORD_RESPONSES=false
# Set to yes only after the OpenRouter key has a credit limit (read by make record).
KEY_CREDIT_LIMIT_CONFIRMED=

# Worker (docs/design/worker-lld.md section 7). The poll is the pause when no job is due; the
# lease must be at least 2 * GATEWAY_TIMEOUT_SECONDS + 30 or the Worker refuses to start.
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=180

# Database roles (migration 0002). Set these before `make migrate` to give the roles a login
# password; left empty, the roles are created NOLOGIN, so no default password can exist. The Api
# process then connects as hirekit_api and the Worker as hirekit_worker, each with its own
# DATABASE_URL; the owner URL stays for migrations and tests.
HIREKIT_API_PASSWORD=
HIREKIT_WORKER_PASSWORD=
